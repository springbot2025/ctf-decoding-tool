{
  "productName": "CTF Tool",
  "version":     "0.1.0",
  "identifier":  "com.spring.ctf-tool",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl":       "http://localhost:1420",
    "beforeDevCommand":   "cd ../../frontend && npm run dev",
    "beforeBuildCommand": "cd ../../frontend && npm run build"
  },
  "app": {
    "windows": [
      {
        "title":            "CTF Tool",
        "width":            1100,
        "height":           720,
        "minWidth":         800,
        "minHeight":        560,
        "resizable":        true,
        "fullscreen":       false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
